    "# Suavizado de la imágen con filtros Gaussiano y Mediana \n",
    "r = df[(df[\"Clase\"] == \"MS\") & (df[\"Corte\"] == \"Axial\")].sample(1).iloc[0]\n",
    "img = a_gris(r[\"ruta\"]).astype(float)\n",
    "\n",
    "versiones = {\n",
    "    \"Original\":       img,\n",
    "    \"Gaussiano σ=1\":  ndi.gaussian_filter(img, 1),\n",
    "    \"Gaussiano σ=2\":  ndi.gaussian_filter(img, 2),\n",
    "    \"Mediana 3x3\":    ndi.median_filter(img, size=3),\n",
    "    \"Mediana 5x5\":    ndi.median_filter(img, size=5),\n",
    "}\n",
    "\n",
    "h, w = img.shape\n",
    "zoom = (slice(h // 3, h // 3 + 100), slice(w // 3, w // 3 + 100))\n",
    "fig, axs = plt.subplots(2, 5, figsize=(18, 7.5))\n",
    "for j, (nombre, im) in enumerate(versiones.items()):\n",
    "    titulo = nombre\n",
    "    if nombre != \"Original\":\n",
    "        titulo += f\"\\nSSIM = {ssim(img, im, data_range=255):.3f} | PSNR = {psnr(img, im, data_range=255):.1f} dB\"\n",
    "    axs[0, j].imshow(im, cmap=\"gray\", vmin=0, vmax=255)\n",
    "    axs[0, j].set_title(titulo)\n",
    "    axs[1, j].imshow(im[zoom], cmap=\"gray\", vmin=0, vmax=255)\n",
    "    axs[1, j].set_title(\"Zoom\")\n",
    "fig.suptitle(f\"Imagen: {r['ruta'].name} ({w}x{h})\")\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
