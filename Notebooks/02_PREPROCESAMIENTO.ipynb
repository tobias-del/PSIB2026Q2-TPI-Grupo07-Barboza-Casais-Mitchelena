    "# Segunda versión de la máscara cerebral: conservamos TODAS las islas compactas y grandes (no solo la mayor)\n",
    "RADIO = 6           # radio de erosión/dilatación (px)\n",
    "FRAC_AREA = 0.25    # área mínima de una isla, relativa a la mayor isla compacta\n",
    "SOLIDEZ_MIN = 0.3   # solidez mínima (área / área de la envolvente convexa) para descarta arcos finos como el cuero cabelludo\n",
    "\n",
    "r = df.sample(1).iloc[0]\n",
    "# r = df[(df[\"ruta\"].apply(lambda p: p.name) == \"A1 (289).png\") & (df[\"Corte\"] == \"Axial\")].iloc[0]   # para probar un corte puntual\n",
    "img = a_gris(r[\"ruta\"])\n",
    "s = ndi.median_filter(img.astype(float), size=3)   # filtro de mediana 3x3\n",
    "\n",
    "umbral = filters.threshold_otsu(s)\n",
    "m1 = s > umbral                                           # 1. máscara de Otsu\n",
    "est = morphology.disk(RADIO)\n",
    "m2 = ndi.binary_erosion(m1, structure=est)                # 2. erosión\n",
    "lab = measure.label(m2)\n",
    "assert lab.max() > 0, \"La erosión borró todo: bajar el RADIO\"\n",
    "\n",
    "props = measure.regionprops(lab)\n",
    "compactas = [p for p in props if p.solidity >= SOLIDEZ_MIN]\n",
    "assert compactas, \"Ninguna isla es compacta: corte sin cerebro útil\"\n",
    "amax = max(p.area for p in compactas)\n",
    "conservar = [p.label for p in compactas if p.area >= FRAC_AREA * amax]\n",
    "m3 = ndi.binary_fill_holes(np.isin(lab, conservar))       # 3. islas compactas y grandes + relleno de huecos\n",
    "m4 = ndi.binary_dilation(m3, structure=est)               # 4. dilatación = máscara final\n",
    "print(f\"{r['ruta'].name}: {len(conservar)} isla(s) conservada(s) de {len(props)}\")\n",
    "\n",
    "fig, axs = plt.subplots(1, 6, figsize=(24, 4.5))\n",
    "axs[0].imshow(img, cmap=\"gray\", vmin=0, vmax=255);  axs[0].set_title(\"Original\")\n",
    "axs[1].imshow(m1, cmap=\"gray\");  axs[1].set_title(f\"1. Otsu (umbral = {umbral:.0f})\")\n",
    "axs[2].imshow(m2, cmap=\"gray\");  axs[2].set_title(\"2. Erosión\")\n",
    "axs[3].imshow(m3, cmap=\"gray\");  axs[3].set_title(\"3. Islas compactas y grandes + relleno\")\n",
    "axs[4].imshow(m4, cmap=\"gray\");  axs[4].set_title(\"4. Dilatación (máscara final)\")\n",
    "axs[5].imshow(img, cmap=\"gray\", vmin=0, vmax=255)\n",
    "axs[5].contour(m4.astype(float), levels=[0.5], colors=\"r\", linewidths=1)\n",
    "axs[5].set_title(\"Contorno sobre la imagen\")\n",
    "fig.suptitle(f\"{r['Clase']} {r['Corte']} - {r['ruta'].name} ({img.shape[1]}x{img.shape[0]})\")\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
