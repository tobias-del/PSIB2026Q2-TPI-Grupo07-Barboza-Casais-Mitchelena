    "# Normalización: estandarización de niveles de gris\n",
    "\n",
    "v = img[m4].astype(float)\n",
    "q1, med, q3 = np.percentile(v, [25, 50, 75]) #Cuartiles\n",
    "iqr = q3 - q1 # Rango intercuatílico\n",
    "z = (img.astype(float) - med) / iqr # Z score\n",
    "\n",
    "print(f\"Imagen: {r['Clase']} {r['Corte']} - {r['ruta'].name}\")\n",
    "print(f\"Dentro de la máscara:  Q1 = {q1:.1f} | mediana = {med:.1f} | Q3 = {q3:.1f} | IQR = {iqr:.1f}\")\n",
    "\n",
    "fig, axs = plt.subplots(1, 3, figsize=(13, 4.5), gridspec_kw={\"width_ratios\": [1, 1, 1.6]})\n",
    "axs[0].imshow(img, cmap=\"gray\", vmin=0, vmax=255)\n",
    "axs[0].set_title(\"Original\")\n",
    "axs[1].imshow(np.where(m4, z, np.nan), cmap=\"gray\", vmin=-3, vmax=5)\n",
    "axs[1].set_title(\"Normalizada (dentro de la máscara)\")\n",
    "h1 = axs[2].hist(img[m4], bins=160, range=(0, 255), alpha=0.6, color=\"gray\", label=\"Antes (nivel de gris)\")\n",
    "axs[2].set_xlabel(\"Nivel de gris\")\n",
    "ax2 = axs[2].twiny()\n",
    "h2 = ax2.hist(z[m4], bins=100, range=(-3, 5), alpha=0.5, color=\"tab:red\", label=\"Después (z-score)\")\n",
    "ax2.set_xlabel(\"z-score (naranja)\")\n",
    "axs[2].set_title(\"Histograma dentro de la máscara\")\n",
    "axs[2].legend(handles=[h1[2][0], h2[2][0]], loc=\"upper right\")\n",
    "plt.tight_layout()\n",
    "#plt.subplots_adjust(wspace=0.06)\n",
    "plt.show()"
   ]
