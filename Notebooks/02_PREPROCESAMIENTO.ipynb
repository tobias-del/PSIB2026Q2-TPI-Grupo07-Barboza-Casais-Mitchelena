    "TAM = 256   # lado del cuadrado final (px)\n",
    "\n",
    "def a_tamano_comun(arr, tam=TAM, orden=1):\n",
    "    \"\"\"Escala manteniendo la proporción (el lado mayor queda en `tam`) y centra en un cuadrado tam x tam, rellenando con ceros.\"\"\"\n",
    "    h, w = arr.shape\n",
    "    f = tam / max(h, w)\n",
    "    nh, nw = round(h * f), round(w * f)\n",
    "    chico = resize(arr.astype(float), (nh, nw), order=orden, anti_aliasing=(orden > 0), preserve_range=True)\n",
    "    out = np.zeros((tam, tam))\n",
    "    y0, x0 = (tam - nh) // 2, (tam - nw) // 2\n",
    "    out[y0:y0 + nh, x0:x0 + nw] = chico\n",
    "    return out\n",
    "\n",
    "z_final = a_tamano_comun(np.where(m4, z, 0))          # imagen normalizada (0 fuera de la máscara)\n",
    "m_final = a_tamano_comun(m4, orden=0) > 0.5           # máscara, con interpolación de vecino más cercano\n",
    "\n",
    "print(f\"Antes: {img.shape[::-1]} (ancho x alto) -> Después: {z_final.shape[::-1]}\")\n",
    "\n",
    "fig, axs = plt.subplots(1, 3, figsize=(15, 4.5), gridspec_kw={\"width_ratios\": [1, 1, 1]})\n",
    "axs[0].imshow(img, cmap=\"gray\", vmin=0, vmax=255); axs[0].set_title(f\"Original {img.shape[1]}x{img.shape[0]}\")\n",
    "axs[1].imshow(np.where(m_final, z_final, np.nan), cmap=\"gray\", vmin=-3, vmax=5); axs[1].set_title(f\"Normalizada y a tamaño común {TAM}x{TAM} px\")\n",
    "axs[2].imshow(m_final, cmap=\"gray\"); axs[2].set_title(\"Máscara\")\n",
